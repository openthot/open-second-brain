# Notion Integration Secret (Created at https://www.notion.so/my-integrations)
NOTION_API_KEY=secret_your_notion_api_key_here

# The Page ID of an empty page in your workspace where OpenSecondBrain should be installed
# (Obtained from the page URL: notion.so/Your-Page-Title-<PAGE_ID>)
NOTION_PARENT_PAGE_ID=your_parent_page_id_here
